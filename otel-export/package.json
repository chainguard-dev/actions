{
  "name": "otel-export",
  "version": "0.1.0",
  "description": "GitHub Action that exports workflow metrics and traces via OpenTelemetry Collector",
  "type": "module",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [
    "github-actions",
    "opentelemetry",
    "metrics",
    "traces",
    "otel-collector"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "rollup": "^4.67.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
